---
import { site } from "../data/site";
const items = [
  { label: "About Me", href: "/" },
  { label: "News", href: "/news/" },
  { label: "Publications", href: "/publications/" },
  { label: "Services", href: "/services/" }
];
const path = Astro.url.pathname;
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="nav-shell">
    <a href="/" class="brand" aria-label={site.name + " home"}>{site.name}</a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {items.map((item) => <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>)}
    </nav>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch color theme">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.2A8.7 8.7 0 0 1 8.8 3.6 8.9 8.9 0 1 0 20.4 15.2Z"/></svg>
      </button>
      <details class="mobile-menu">
        <summary aria-label="Open navigation menu"><span class="menu-glyph" aria-hidden="true"></span><span class="visually-hidden">Menu</span></summary>
        <nav aria-label="Mobile navigation">
          {items.map((item) => <a href={item.href} aria-current={path === item.href ? "page" : undefined}>{item.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
