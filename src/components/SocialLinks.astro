---
import { site } from "../data/site";
const { compact = false } = Astro.props;
const links = [
  { name: site.scholarLabel, short: "Scholar", href: site.scholarUrl, icon: "scholar" },
  { name: site.githubLabel, short: "GitHub", href: site.githubUrl, icon: "github" },
  { name: "LinkedIn", short: "LinkedIn", href: site.linkedinUrl, icon: "linkedin" },
  { name: "Email Ali Golestaneh", short: "Email", href: "mailto:" + site.email, icon: "mail" }
];
---

<div class:list={["social-links", compact && "social-compact"]} aria-label="Professional links">
  {links.map((link) => (
    <a href={link.href} aria-label={link.name} title={link.name} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        {link.icon === "scholar" && <><path d="m2.4 9.3 9.6-5.6 9.6 5.6-9.6 5.4-9.6-5.4Z"/><path d="M6 11.5v4.2c3.8 3.5 8.2 3.5 12 0v-4.2"/></>}
        {link.icon === "github" && <><path d="M12 2.2a9.8 9.8 0 0 0-3.1 19.1c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.6 1 1.6 1 .9 1.5 2.3 1.1 2.8.8.1-.6.4-1.1.7-1.3-2.2-.3-4.5-1.1-4.5-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.5 4.9.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.8 9.8 0 0 0 12 2.2Z"/></>}
        {link.icon === "linkedin" && <><path d="M5.3 8.6a2 2 0 1 0 0-4.1 2 2 0 0 0 0 4.1ZM3.6 10h3.4v10.4H3.6zM9 10h3.3v1.4h.1c.5-.9 1.6-1.8 3.3-1.8 3.5 0 4.2 2.2 4.2 5.1v5.7h-3.4v-5.1c0-1.2 0-2.8-1.8-2.8s-2.1 1.3-2.1 2.7v5.2H9z"/></>}
        {link.icon === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></>}
      </svg>
      {!compact && <span>{link.short}</span>}
    </a>
  ))}
</div>
