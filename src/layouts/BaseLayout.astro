---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

const {
  title = site.name + " · Robotics Engineering Ph.D. Student",
  description = "Ali Golestaneh is a Robotics Engineering Ph.D. Student at Worcester Polytechnic Institute working on motion planning, robot learning, and nonprehensile manipulation.",
  path = Astro.url.pathname,
  schema = null
} = Astro.props;
const canonical = new URL(path, site.url).toString();
const pageTitle = title.includes(site.name) ? title : title + " · " + site.name;
const baseSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.publicationName,
  url: site.url,
  email: "mailto:" + site.email,
  image: site.portrait,
  jobTitle: site.role,
  affiliation: [
    { "@type": "CollegeOrUniversity", name: "Worcester Polytechnic Institute", url: site.wpiUrl },
    { "@type": "Organization", name: "ELPIS Lab", url: site.labUrl }
  ],
  sameAs: [site.linkedinUrl, site.scholarUrl, site.githubUrl]
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon-robot.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#302543" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-card.png", site.url).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ali Golestaneh — Robotics Engineering Ph.D. Student in motion planning, robot learning, and manipulation" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-card.png", site.url).toString()} />
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)}></script>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("ag-theme");
          const preferred = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = stored || preferred;
        } catch (_) {}
      })();
    </script>
  </head>
  <body id="top">
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const setTheme = (theme: "light" | "dark") => {
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem("ag-theme", theme); } catch (_) {}
        if (themeToggle) {
          themeToggle.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
          themeToggle.setAttribute("aria-pressed", String(theme === "dark"));
        }
      };
      setTheme(document.documentElement.dataset.theme === "dark" ? "dark" : "light");
      themeToggle?.addEventListener("click", () => {
        setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark");
      });
      document.querySelectorAll<HTMLAnchorElement>(".mobile-menu nav a").forEach((link) => {
        link.addEventListener("click", () => {
          const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
          if (menu) menu.open = false;
        });
      });
      document.querySelectorAll<HTMLButtonElement>(".copy-bibtex").forEach((button) => {
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.bibtex || "");
            button.textContent = "Copied";
            window.setTimeout(() => { button.textContent = "Copy BibTeX"; }, 1600);
          } catch (_) {
            button.textContent = "Select text to copy";
          }
        });
      });
    </script>
    <slot name="scripts" />
  </body>
</html>
